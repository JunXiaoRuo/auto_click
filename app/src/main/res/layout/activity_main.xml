<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_surface"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="应用图标"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Click.PageTitle" />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="正在读取版本"
                android:textAppearance="@style/TextAppearance.Click.Caption" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_permissions"
            style="@style/Widget.Click.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="权限状态"
            app:icon="@drawable/ic_security_24"
            app:iconTint="@color/app_text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_root_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_status_error"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="42dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="正在检查 Root 状态"
        android:textAppearance="@style/TextAppearance.Click.Body"
        android:textColor="@color/app_error"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/app_surface_variant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="方案"
            android:textAppearance="@style/TextAppearance.Click.SectionTitle" />

        <Spinner
            android:id="@+id/sp_scheme_selector"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/app_outline"
            android:popupBackground="@color/app_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_new_scheme"
            style="@style/Widget.Click.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="新建方案"
            app:icon="@drawable/ic_add_24"
            app:iconTint="@color/app_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_scheme"
            style="@style/Widget.Click.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="保存方案"
            app:icon="@drawable/ic_save_24"
            app:iconTint="@color/app_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_scheme"
            style="@style/Widget.Click.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="删除方案"
            app:icon="@drawable/ic_delete_24"
            app:iconTint="@color/app_error" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="目标应用"
            android:textAppearance="@style/TextAppearance.Click.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Click.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="未选择则不跳转">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_app_activity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_app"
                style="@style/Widget.Click.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="选择"
                app:icon="@drawable/ic_apps_24"
                app:iconTint="@color/app_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_app"
                style="@style/Widget.Click.Button.Icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:contentDescription="清除目标或步骤"
                app:icon="@drawable/ic_close_24"
                app:iconTint="@color/app_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="操作步骤"
                android:textAppearance="@style/TextAppearance.Click.SectionTitle" />

            <TextView
                android:id="@+id/tv_operation_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 个步骤"
                android:textAppearance="@style/TextAppearance.Click.Caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_operation"
                style="@style/Widget.Click.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="添加步骤"
                app:icon="@drawable/ic_add_24"
                app:iconTint="@color/app_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_recording"
                style="@style/Widget.Click.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="录制动作"
                app:icon="@drawable/ic_record_24"
                app:iconTint="@color/app_error" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@color/app_surface">

            <ListView
                android:id="@+id/lv_operations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/app_surface"
                android:clipToPadding="false"
                android:divider="@color/app_outline"
                android:dividerHeight="1dp"
                android:listSelector="@drawable/bg_list_item"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/tv_empty_operations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="还没有操作步骤\n可以手动添加或开始录制"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.Click.Caption" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layout_completion_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="完成后停止应用"
                    android:textAppearance="@style/TextAppearance.Click.Body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="用于结束被自动化的目标进程"
                    android:textAppearance="@style/TextAppearance.Click.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_apps_to_stop"
                style="@style/Widget.Click.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="选择应用" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_stop_apps_enabled"
                style="@style/Widget.Click.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_surface"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_execute"
            style="@style/Widget.Click.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="执行"
            app:icon="@drawable/ic_play_24"
            app:iconTint="@color/app_on_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            style="@style/Widget.Click.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="设置"
            app:icon="@drawable/ic_settings_24"
            app:iconTint="@color/app_primary" />
    </LinearLayout>
</LinearLayout>
