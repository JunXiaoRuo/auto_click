<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="这些权限用于跨应用录制、执行和后台保活。"
            android:textAppearance="@style/TextAppearance.Click.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Root 权限" android:textAppearance="@style/TextAppearance.Click.Body" android:textStyle="bold" />
                <TextView android:id="@+id/tv_root_perm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="未知" android:textAppearance="@style/TextAppearance.Click.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_get_root" style="@style/Widget.Click.Button.Secondary"
                android:layout_width="wrap_content" android:layout_height="44dp" android:text="获取" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/app_outline" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="通知权限" android:textAppearance="@style/TextAppearance.Click.Body" android:textStyle="bold" />
                <TextView android:id="@+id/tv_notify_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="未知" android:textAppearance="@style/TextAppearance.Click.Caption" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_open_notify" style="@style/Widget.Click.Button.Text"
                android:layout_width="wrap_content" android:layout_height="40dp" android:text="去设置" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/app_outline" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="悬浮窗权限" android:textAppearance="@style/TextAppearance.Click.Body" android:textStyle="bold" />
                <TextView android:id="@+id/tv_overlay_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="未知" android:textAppearance="@style/TextAppearance.Click.Caption" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_overlay_perm" style="@style/Widget.Click.Button.Text"
                android:layout_width="wrap_content" android:layout_height="40dp" android:text="去设置" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/app_outline" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="电池优化" android:textAppearance="@style/TextAppearance.Click.Body" android:textStyle="bold" />
                <TextView android:id="@+id/tv_battery_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="未知" android:textAppearance="@style/TextAppearance.Click.Caption" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_ignore_battery" style="@style/Widget.Click.Button.Text"
                android:layout_width="wrap_content" android:layout_height="40dp" android:text="关闭优化" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/app_outline" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_keep_alive_perm"
            style="@style/Widget.Click.CheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="服务保活（显示常驻通知）" />
    </LinearLayout>
</ScrollView>
