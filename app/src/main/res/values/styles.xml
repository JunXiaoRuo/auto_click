<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeOverlay.Click.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Click.Dialog</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
    </style>

    <style name="ShapeAppearance.Click.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="TextAppearance.Click.PageTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Click.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Click.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Click.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Click.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/app_primary</item>
    </style>

    <style name="Widget.Click.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/app_outline</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="Widget.Click.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/app_primary</item>
    </style>

    <style name="Widget.Click.Button.Icon" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">6dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/app_text_secondary</item>
    </style>

    <style name="Widget.Click.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
        <item name="boxStrokeColor">@color/app_outline</item>
        <item name="hintTextColor">@color/app_text_secondary</item>
    </style>

    <style name="Widget.Click.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>

    <style name="Widget.Click.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/control_button_tint</item>
    </style>
</resources>
