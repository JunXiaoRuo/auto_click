<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Click" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorPrimaryVariant">@color/app_primary_dark</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorSecondaryVariant">@color/app_secondary</item>
        <item name="colorOnSecondary">@color/app_on_secondary</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorError">@color/app_error</item>
        <item name="android:colorAccent">@color/app_primary</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_surface</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Click.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Click.MaterialAlertDialog</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
